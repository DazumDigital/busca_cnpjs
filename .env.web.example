# Copie para .env.web, arquivo privado. Não copie o .env da POC.
WEB_ENV=local
WEB_ORIGIN=http://127.0.0.1:8000
# Arquivo NOVO, separado de todos os bancos históricos.
WEB_DATABASE_URL=sqlite:///var/platform.sqlite
# Permanece false: pesquisas armazenadas não fazem chamadas externas.
WEB_ENABLE_EXTERNAL=false
# Produção: WEB_ENV=production; WEB_ORIGIN=https://seu-dominio
# WEB_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST/DB?sslmode=verify-full&sslrootcert=system
# Preview precisa de banco isolado da produção, com seu próprio saldo.
